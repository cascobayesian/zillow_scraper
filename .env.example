# Global scraper settings (copy to .env). All are optional; defaults shown.
PROXY_FILE=proxies.txt
# Pages scraped through one proxy (fresh browser profile) before rotating to the next.
PAGES_PER_PROXY=1
# How long a proxy is rested after a CAPTCHA or connection failure.
PROXY_COOLDOWN_SECONDS=900
# Randomized gap between page loads, shared across all proxies.
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=45
# Exponential backoff after a block: base * 2^(failures-1), capped at max.
BACKOFF_BASE_SECONDS=120
BACKOFF_MAX_SECONDS=1800
MAX_CONSECUTIVE_FAILURES=5
